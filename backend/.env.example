# Backend environment variables (for local development).
# In Docker, these are provided by docker-compose.yml.

NODE_ENV=production

# Prisma connection string; schema matches scripts/init-db.sql
DATABASE_URL=postgresql://postgres:postgres@db:5432/league_draft?schema=draft_db

# Throwaway database used by `npm run db:check-drift` to replay the migrations
# and compare them with schema.prisma. Optional — only that command needs it.
# It must be a separate database (Prisma refuses the same one):
#   docker compose exec db psql -U postgres -c 'CREATE DATABASE league_draft_shadow;'
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/league_draft_shadow?schema=draft_db

REDIS_HOST=redis
REDIS_PORT=6379

PORT=4000

# Must match the JWT_SECRET interpolated into docker-compose.yml
JWT_SECRET=change-me-to-a-long-random-string

# Reconnection grace period (R-013): an in-progress draft expires when a
# player stays disconnected longer than this many milliseconds. Defaults to
# 30000 (30s) when unset.
DRAFT_GRACE_PERIOD_MS=30000

# Turn countdown override for tests/dev (T-009): shortens every ban/pick turn.
# Unset keeps the spec timing (30s ban/pick turns, 60s finalization).
DRAFT_TURN_TIMER_MS=30000

# Finalization countdown override (T-014). Defaults to 2x
# DRAFT_TURN_TIMER_MS when that override is set, otherwise 60000 (60s).
DRAFT_FINALIZATION_TIMER_MS=60000

# Base URL of Riot's Data Dragon CDN (public, no API key). The service calls
# GET {DATA_DRAGON_BASE_URL}/api/versions.json and
# GET {DATA_DRAGON_BASE_URL}/cdn/<patch>/data/en_US/champion.json (see T-005).
# Leave empty to use the default https://ddragon.leagueoflegends.com.
DATA_DRAGON_BASE_URL=
