# Backend environment variables (for local development).
# In Docker, these are provided by docker-compose.yml.

NODE_ENV=production

# Prisma connection string; schema matches scripts/init-db.sql
DATABASE_URL=postgresql://postgres:postgres@db:5432/league_draft?schema=draft_db

REDIS_HOST=redis
REDIS_PORT=6379

PORT=4000

# Must match the JWT_SECRET interpolated into docker-compose.yml
JWT_SECRET=change-me-to-a-long-random-string

# Reconnection grace period (R-013): an in-progress draft expires when a
# player stays disconnected longer than this many milliseconds. Defaults to
# 30000 (30s) when unset.
DRAFT_GRACE_PERIOD_MS=30000

# Base URL of Riot's Data Dragon CDN (public, no API key). The service calls
# GET {DATA_DRAGON_BASE_URL}/api/versions.json and
# GET {DATA_DRAGON_BASE_URL}/cdn/<patch>/data/en_US/champion.json (see T-005).
# Leave empty to use the default https://ddragon.leagueoflegends.com.
DATA_DRAGON_BASE_URL=
