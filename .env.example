# Root environment file for docker-compose (compose interpolates ${JWT_SECRET}).
# Copy to .env and set a strong random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL password used by the local Compose database. The default is a
# development-only value; set a URL-safe random string for any shared host.
#   openssl rand -hex 24
POSTGRES_PASSWORD=postgres

# Base URL of Riot's Data Dragon CDN (see backend/.env.example).
# Leave empty to use the default https://ddragon.leagueoflegends.com.
DATA_DRAGON_BASE_URL=
